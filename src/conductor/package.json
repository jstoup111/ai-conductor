{
  "name": "@james-stoup-agents/conductor",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/publish-engine.mjs",
    "test": "sh -c \"vitest run --reporter=dot --silent --slowTestThreshold=1800000 \\\"\\$@\\\" && echo 'AGGREGATE_TEST_SUITE_PASS'\" --",
    "test:changed": "sh -c \"vitest run --reporter=dot --changed --silent --slowTestThreshold=1800000 \\\"\\$@\\\" && echo 'AGGREGATE_TEST_SUITE_PASS'\" --",
    "test:watch": "vitest",
    "smoke": "node --import tsx scripts/smoke.ts vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --max-warnings=0 \"src/**/*.ts\" \"test/**/*.ts\" --fix"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/otlp-transformer": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "semver": "^7.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  }
}
