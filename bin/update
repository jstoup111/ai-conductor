#!/usr/bin/env bash
set -euo pipefail

# update — Standalone self-update/channel CLI for the harness.
# bin/update and bin/lib/harness-common.sh are the permanent homes for this
# shell-side maintenance flow.
#
# Usage:
#   update                          — force an update check now, bypassing the autoCheck gate
#   update --auto                   — check only if autoCheck config is not false (silent no-op otherwise); used by conduct-ts at startup
#   update --set-channel <tagged|stable|main> — set the update channel
#   update -h|--help                — usage

HARNESS_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# True only under `--auto`, the advisory startup check. A major upgrade is
# reported but never applied from there — see major_update_gate.
UPDATE_AUTO_MODE=false

# Not a git checkout — nothing to check/update/configure. Bail before even
# sourcing harness-common.sh so a harness install missing bin/lib (or any
# other non-git tree bin/update happens to run inside) still exits cleanly.
if [ ! -d "${HARNESS_DIR}/.git" ]; then
  exit 0
fi

# shellcheck source=bin/lib/harness-common.sh
source "${HARNESS_DIR}/bin/lib/harness-common.sh"

# ─── Update check functions ───────────────────────────────────────────────

# Render the CHANGELOG.md blocks strictly between from_ver (exclusive) and
# to_ver (inclusive) using the user's configured markdown viewer. Writes to
# a temp file so external/blocking viewers (VSCode, Typora) can open it the
# same way they would for artifact review.
render_changelog_range() {
  local from_ver=$1 to_ver=$2
  local changelog="${HARNESS_DIR}/CHANGELOG.md"
  [ -f "$changelog" ] || return 0
  local preview
  preview=$(FROM_VER="$from_ver" TO_VER="$to_ver" conductor_python - "$changelog" <<'PY'
import os, re, sys
from pathlib import Path

def norm(v):
    if not v:
        return ()
    s = v.lstrip("v")
    try:
        return tuple(int(p) for p in s.split("."))
    except ValueError:
        return ()

path = Path(sys.argv[1])
text = path.read_text()
from_ver = norm(os.environ.get("FROM_VER", ""))
to_ver = norm(os.environ.get("TO_VER", ""))

sections = re.split(r"(?m)^## \[", text)
out = []
for sec in sections[1:]:
    m = re.match(r"([^\]]+)\]", sec)
    if not m:
        continue
    label = m.group(1).strip()
    if label.lower() == "unreleased":
        continue
    nv = norm(label)
    if not nv:
        continue
    if (not from_ver or nv > from_ver) and (not to_ver or nv <= to_ver):
        body = sec[m.end():].rstrip()
        out.append(f"## [{label}]{body}\n")
sys.stdout.write("\n".join(reversed(out)))
PY
  )
  [ -z "$preview" ] && return 0
  local tmp
  tmp=$(mktemp --suffix=.md 2>/dev/null || mktemp -t changelog.XXXXXX.md)
  printf '%s\n' "$preview" > "$tmp"
  # Deliberately bypass render_md's configured markdown_viewer here: its
  # default args ("-p -w 80 {file}") open glow in full-screen pager mode,
  # which steals the same stdin the y/n prompt right after this call needs
  # to read. A human would press "q" to dismiss it and continue, but that
  # extra keypress isn't part of the documented confirm-prompt UX, and any
  # scripted/piped stdin (tests, non-interactive callers) hangs forever
  # waiting for a quit key that never comes. Render the preview as plain,
  # non-paged output instead so the prompt's read is never starved. Plain
  # `cat` (no glow ANSI styling) also keeps this preview deterministically
  # greppable for callers/tests scanning the printed changelog text.
  cat "$tmp"
  rm -f "$tmp"
}

# Compare two semver-ish versions. Returns 0 if $1 < $2 (i.e. update available).
semver_lt() {
  [ "$1" = "$2" ] && return 1
  local a="${1#v}" b="${2#v}"
  local hi
  hi=$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -1)
  [ "$hi" = "$b" ]
}

# True when moving from $1 to $2 crosses a semver MAJOR boundary. Per this
# harness's own semver rules a MAJOR is a breaking change to skill contracts,
# the CLI, or the settings.json schema, so it is the one upgrade that must not
# be accepted by reflex. `0.x → 1.0` counts: the leading component differs.
# Anything not shaped vX.Y.Z (an undeterminable baseline, a main@<sha>
# identity) is not a major crossing — those channels have no semver to compare.
is_major_upgrade() {
  local from="${1#v}" to="${2#v}"
  [[ "$from" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$to" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [ "${from%%.*}" != "${to%%.*}" ]
}

# Approval gate for a MAJOR upgrade. Returns 0 to proceed, 1 to stop.
#
# A non-major upgrade returns 0 immediately and keeps the ordinary [y/n] flow
# below it untouched. A major upgrade is never applied from the startup
# auto-check (`--auto`) — it is reported and left for a deliberate `bin/update`
# — and an interactive run must type the target version rather than one key.
# $3 is the manual command a non-interactive caller should run instead.
major_update_gate() {
  local from=$1 to=$2 manual_hint=$3 typed=""

  is_major_upgrade "$from" "$to" || return 0

  echo ""
  warn "MAJOR update ${from} → ${to} — may break skill contracts, the CLI, or the settings.json schema."

  if [ "$UPDATE_AUTO_MODE" = true ]; then
    info "Not applied automatically. Run: cd ${HARNESS_DIR} && bin/update"
    return 1
  fi
  if [ ! -t 0 ]; then
    warn "No TTY — run: ${manual_hint}"
    return 1
  fi

  read -r -p "  Type ${to} to confirm this major update (or 'n' to skip): " typed
  if [ "${typed#v}" = "${to#v}" ] && [ -n "$typed" ]; then
    return 0
  fi
  log "Skipping update"
  return 1
}

# Run bin/migrate for the accepted update, then write the new currentVersion
# back to config and re-launch conduct. On failure, roll back the checkout.
apply_harness_update() {
  local new_version=$1 rollback_ref=$2

  if "${HARNESS_DIR}/bin/migrate"; then
    conductor_cfg_set currentVersion "$new_version"
    conductor_cfg_set lastCheckedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ok "Harness updated to ${new_version}. Re-run to pick up the change."
    return 0
  else
    fail "bin/migrate failed — rolling back to ${rollback_ref}"
    git -C "$HARNESS_DIR" checkout "$rollback_ref" >/dev/null 2>&1 || true
    return 1
  fi
}

# Tagged-channel update: find the latest vX.Y.Z tag and prompt before applying.
check_harness_update_tagged() {
  timeout 5 git -C "$HARNESS_DIR" fetch --tags --quiet 2>/dev/null || return 0

  # The checkout is the sole identity authority. The resolver supplies its
  # reachable release baseline; persisted currentVersion is only refreshed
  # from an exact checked-out release and is never read for this decision.
  local _identity_kind _display_identity baseline _distance _source
  IFS=$'\t' read -r _identity_kind _display_identity baseline _distance _source \
    < <(resolve_harness_identity "$HARNESS_DIR")

  # Bash collapses consecutive tab separators while reading the resolver's
  # intentionally empty undeterminable baseline and distance fields.
  [ "$_identity_kind" = "undeterminable" ] && _source="none"

  if [ "$_identity_kind" = "undeterminable" ]; then
    echo "Update identity: unverifiable (source: ${_source})"
    warn "Installed tagged release is unverifiable; cannot check for tagged updates."
    return 0
  fi

  local latest_tag
  latest_tag=$(git -C "$HARNESS_DIR" tag -l 'v*.*.*' --sort=-v:refname 2>/dev/null | head -1)
  [ -z "$latest_tag" ] && return 0

  echo "Update identity: ${_display_identity} (source: ${_source})"

  if ! [[ "$baseline" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    warn "Installed tagged release is unverifiable; cannot check for tagged updates."
    return 0
  fi

  # This is a write-only cache for bin/migrate's semver lower bound, never
  # an input to update identity or offer decisions. Persist the checkout's
  # bare baseline before any no-update, no-TTY, or declined-offer exit.
  conductor_cfg_set currentVersion "$baseline" || \
    warn "Could not record the installed release baseline."

  if [ "$_identity_kind" = "post-release" ]; then
    local commit_label="commits"
    [ "$_distance" = "1" ] && commit_label="commit"
    if [ "$baseline" = "$latest_tag" ]; then
      warn "${_distance} ${commit_label} past ${baseline}, no newer release exists"
      conductor_cfg_set lastCheckedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" || \
        warn "Could not record when the installed release was checked."
      return 0
    fi

    warn "${_distance} ${commit_label} past ${baseline}"
  fi

  if ! semver_lt "$baseline" "$latest_tag"; then
    conductor_cfg_set lastCheckedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" || \
      warn "Could not record when the installed release was checked."
    ok "Harness is up to date at ${baseline}."
    return 0
  fi

  echo ""
  warn "Harness update available: ${baseline} → ${latest_tag}"
  echo ""
  render_changelog_range "$baseline" "$latest_tag"
  echo ""

  local manual_hint="cd ${HARNESS_DIR} && git checkout ${latest_tag} && bin/migrate"
  if is_major_upgrade "$baseline" "$latest_tag"; then
    # The typed confirmation inside the gate IS this update's approval; the
    # ordinary [y/n] must not also run and re-ask with one key.
    major_update_gate "$baseline" "$latest_tag" "$manual_hint" || return 0
  else
    if [ ! -t 0 ]; then
      warn "No TTY — run: ${manual_hint}"
      return 0
    fi
    read -r -p "  Update to ${latest_tag}? [y/n]: " choice
    case "$choice" in
      [yY]) ;;
      *) log "Skipping update"; return 0 ;;
    esac
  fi

  local rollback_ref
  rollback_ref=$(git -C "$HARNESS_DIR" rev-parse HEAD 2>/dev/null || echo "HEAD")
  if ! git -C "$HARNESS_DIR" checkout "tags/${latest_tag}" 2>/dev/null; then
    fail "Failed to checkout ${latest_tag} — update aborted"
    return 0
  fi
  apply_harness_update "$latest_tag" "$rollback_ref"
}

# Stable-channel update: fast-forward the stable branch to its next tagged
# release and retain that semver tag as the installed version identity.
restore_stable_checkout() {
  local local_head=$1
  git -C "$HARNESS_DIR" reset --hard HEAD >/dev/null 2>&1 &&
    git -C "$HARNESS_DIR" checkout stable >/dev/null 2>&1 &&
    git -C "$HARNESS_DIR" reset --hard "$local_head" >/dev/null 2>&1
}

check_harness_update_stable() {
  timeout 5 git -C "$HARNESS_DIR" fetch --tags --quiet origin stable 2>/dev/null || return 0

  local branch local_head remote_head target_version detached=false
  branch=$(git -C "$HARNESS_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  if [ "$branch" != "stable" ]; then
    # A stable install updated by a pre-v1 bin/update was moved with
    # `git checkout vX.Y.Z`, which leaves it in detached HEAD and off the
    # branch. Returning here would silently and permanently end every later
    # stable update for that install, so a detached HEAD is recovered onto the
    # stable branch once the ancestry test below proves it is that lineage.
    # Any other branch is still left alone.
    [ "$branch" = "HEAD" ] || return 0
    detached=true
  fi

  local_head=$(git -C "$HARNESS_DIR" rev-parse HEAD 2>/dev/null || echo "")
  remote_head=$(git -C "$HARNESS_DIR" rev-parse origin/stable 2>/dev/null || echo "")
  [ -z "$remote_head" ] && return 0

  # Ancestry is what makes a detached HEAD *this install's* stable lineage. It
  # is tested before the tag guard below so a deliberate, unrelated detached
  # checkout stays silent instead of inheriting stable's refusals.
  if [ "$detached" = true ] &&
    ! git -C "$HARNESS_DIR" merge-base --is-ancestor HEAD origin/stable 2>/dev/null; then
    return 0
  fi

  target_version=$(git -C "$HARNESS_DIR" describe --tags --exact-match "$remote_head" --match 'v*.*.*' 2>/dev/null || echo "")
  if ! [[ "$target_version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    fail "Stable update refused: origin/stable must point to an exact semver vX.Y.Z tag"
    return 1
  fi
  # Already at the release: nothing to apply — unless HEAD is still detached,
  # where re-attaching the branch is itself the whole repair.
  if [ "$local_head" = "$remote_head" ] && [ "$detached" != true ]; then
    return 0
  fi

  if ! git -C "$HARNESS_DIR" merge-base --is-ancestor HEAD origin/stable 2>/dev/null; then
    return 0
  fi
  if [ -n "$(git -C "$HARNESS_DIR" status --porcelain 2>/dev/null)" ]; then
    fail "Stable update refused: the stable checkout must be clean"
    return 1
  fi

  echo ""
  local prompt="  Pull latest stable release? [y/n]: "
  if [ "$detached" = true ]; then
    warn "Stable checkout is detached from the stable branch — recovery available at ${target_version}"
    prompt="  Re-attach the stable branch at ${target_version}? [y/n]: "
  else
    warn "Harness stable update available"
  fi
  local manual_hint="cd ${HARNESS_DIR} && git pull --ff-only origin stable && bin/migrate"
  if [ "$detached" = true ]; then
    manual_hint="cd ${HARNESS_DIR} && git checkout -B stable ${remote_head} && bin/migrate"
  fi

  # The installed release this move starts from. A detached recovery has
  # local_head == remote_head, so from == to and the gate correctly no-ops:
  # re-attaching the branch is not a version change.
  local stable_from
  stable_from=$(git -C "$HARNESS_DIR" describe --tags --exact-match "$local_head" --match 'v*.*.*' 2>/dev/null || echo "")
  [ -n "$stable_from" ] || stable_from=$(conductor_cfg_get currentVersion "" 2>/dev/null || echo "")

  if is_major_upgrade "$stable_from" "$target_version"; then
    # The typed confirmation inside the gate IS this update's approval.
    major_update_gate "$stable_from" "$target_version" "$manual_hint" || return 0
  else
    if [ ! -t 0 ]; then
      warn "No TTY — run: ${manual_hint}"
      return 0
    fi
    read -r -p "$prompt" choice
    case "$choice" in
      [yY]) ;;
      *) log "Skipping update"; return 0 ;;
    esac
  fi

  local rollback_ref prior_version prior_checked_at
  rollback_ref=$local_head
  if ! prior_version=$(conductor_cfg_get currentVersion ""); then
    warn "Stable update declined: current version identity could not be read"
    return 1
  fi
  prior_checked_at=$(conductor_cfg_get lastCheckedAt "" 2>/dev/null || true)
  # Both branches apply the SHA approved above, never a re-read of
  # origin/stable, so a remote advance during the prompt cannot be picked up.
  if [ "$detached" = true ]; then
    if ! git -C "$HARNESS_DIR" checkout -B stable "$remote_head" >/dev/null 2>&1; then
      fail "Re-attaching the stable branch failed — recover manually: cd ${HARNESS_DIR} && git checkout -B stable ${remote_head}"
      return 1
    fi
    git -C "$HARNESS_DIR" branch --set-upstream-to=origin/stable stable >/dev/null 2>&1 || true
  elif ! git -C "$HARNESS_DIR" merge --ff-only "$remote_head" >/dev/null 2>&1; then
    fail "Fast-forward to approved stable commit failed — update manually: cd ${HARNESS_DIR} && git merge --ff-only ${remote_head}"
    return 1
  fi

  local new_head new_version
  new_head=$(git -C "$HARNESS_DIR" rev-parse HEAD 2>/dev/null || echo "")
  new_version=$(git -C "$HARNESS_DIR" describe --tags --exact-match HEAD --match 'v*.*.*' 2>/dev/null || echo "")
  if [ "$new_head" != "$remote_head" ] || [ "$new_version" != "$target_version" ]; then
    fail "Stable branch head is not an exact semver tag — update aborted"
    restore_stable_checkout "$local_head" || fail "Stable rollback failed — restore ${local_head} manually"
    return 1
  fi

  if apply_harness_update "$new_version" "$rollback_ref"; then
    return 0
  fi

  local restored=true
  restore_stable_checkout "$local_head" || restored=false
  conductor_cfg_set currentVersion "$prior_version" || restored=false
  if [ -n "$prior_checked_at" ]; then
    conductor_cfg_set lastCheckedAt "$prior_checked_at" || restored=false
  fi
  if [ "$restored" != true ]; then
    fail "Stable rollback was incomplete — restore ${local_head} and ${prior_version} manually"
  fi
  return 1
}

# Main-channel update: preserve the old fast-forward pull behavior but run
# bin/migrate afterward so symlinks and settings refresh.
check_harness_update_main() {
  timeout 5 git -C "$HARNESS_DIR" fetch --quiet 2>/dev/null || return 0

  local branch local_head remote_head local_sha behind_count
  branch=$(git -C "$HARNESS_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  [ -z "$branch" ] && return 0

  local_head=$(git -C "$HARNESS_DIR" rev-parse HEAD 2>/dev/null || echo "")
  remote_head=$(git -C "$HARNESS_DIR" rev-parse "origin/${branch}" 2>/dev/null || echo "")
  [ -z "$remote_head" ] && return 0

  local_sha=$(git -C "$HARNESS_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  behind_count=$(git -C "$HARNESS_DIR" rev-list --count "HEAD..origin/${branch}" 2>/dev/null || echo "0")
  echo "Update identity: main@${local_sha} (branch: ${branch}; behind: ${behind_count})"

  [ "$local_head" = "$remote_head" ] && return 0

  if ! git -C "$HARNESS_DIR" merge-base --is-ancestor HEAD "origin/${branch}" 2>/dev/null; then
    return 0
  fi

  [ "$behind_count" = "0" ] && return 0

  echo ""
  warn "Harness update available (${behind_count} commit(s) behind origin/${branch})"
  if [ ! -t 0 ]; then
    warn "Run: cd ${HARNESS_DIR} && git pull && bin/migrate"
    return 0
  fi

  read -r -p "  Pull latest? [y/n]: " choice
  case "$choice" in
    [yY]) ;;
    *) log "Skipping update"; return 0 ;;
  esac

  local rollback_ref
  rollback_ref=$(git -C "$HARNESS_DIR" rev-parse HEAD 2>/dev/null || echo "HEAD")
  if ! git -C "$HARNESS_DIR" pull --ff-only 2>/dev/null; then
    fail "Fast-forward pull failed — update manually: cd ${HARNESS_DIR} && git pull"
    return 0
  fi

  local new_sha
  new_sha=$(git -C "$HARNESS_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  apply_harness_update "main@${new_sha}" "$rollback_ref"
}

# Dispatch on the configured update channel, regardless of autoCheck. Shared
# by the forced (no-args) and auto (--auto, gated) entry points below.
dispatch_update_channel() {
  local channel
  if ! channel=$(conductor_cfg_get updateChannel tagged); then
    # A failed read means either the CLI is absent (decline) or the config is
    # unreadable while the CLI works (degrade to the default channel). Probe
    # the CLI `conductor_cfg_get` actually resolves — probing the retired
    # `conduct-ts` name made the degrade path depend on a stale global install.
    local cli
    cli="$(conductor_cli)"
    if ! command -v "$cli" &>/dev/null; then
      warn "Update check declined: conductor configuration could not be read."
      return 1
    fi
    warn "Conductor configuration could not be read; checking the default tagged channel."
    channel=tagged
  fi
  case "$channel" in
    stable) check_harness_update_stable ;;
    main)   check_harness_update_main ;;
    tagged|*) check_harness_update_tagged ;;
  esac
}

# Forced check — used for the no-args "check now" invocation. Bypasses the
# autoCheck gate (a manual check should always run) but still requires a git
# checkout.
check_harness_update() {
  [ -d "${HARNESS_DIR}/.git" ] || return 0
  dispatch_update_channel
}

# Auto check — used by --auto (e.g. wired into conduct-ts's daemon loop).
# Respects the autoCheck config gate; silent no-op when disabled.
check_harness_update_auto() {
  [ -d "${HARNESS_DIR}/.git" ] || return 0

  local auto_check
  if ! auto_check=$(conductor_cfg_get autoCheck true); then
    warn "Automatic update check declined: conductor configuration could not be read."
    return 1
  fi
  [ "$auto_check" = "false" ] && return 0

  dispatch_update_channel
}

set_update_channel() {
  local new_channel=$1
  case "$new_channel" in
    tagged|stable|main) ;;
    *) fail "Invalid channel: ${new_channel} (expected: tagged, stable, main)"; exit 2 ;;
  esac
  conductor_cfg_set updateChannel "$new_channel" || exit 1
  ok "Update channel set to: ${new_channel}"
  exit 0
}

usage() {
  cat <<'EOF'
Usage: update [OPTIONS]

  (no args)           Force an update check now, bypassing the autoCheck gate.
  --auto              Run an update check only if autoCheck is not "false".
  --set-channel <c>   Set the update channel (tagged, stable, main).
  -h, --help          Show this help message.
EOF
}

# ─── CLI argument dispatch ──────────────────────────────────────────────────

if [ "$#" -eq 0 ]; then
  check_harness_update
  rc=$?
  # Ensure the ~/.ai-conductor global-fallback symlink to the checkout's
  # committed rate card exists (repair after a moved checkout or old install).
  sync_global_rate_card "$HARNESS_DIR"
  exit $rc
fi

case "${1:-}" in
  --auto)
    # Automatic checks are advisory: report an unavailable prerequisite but
    # never make the embedding startup path fail.
    UPDATE_AUTO_MODE=true
    check_harness_update_auto || true
    sync_global_rate_card "$HARNESS_DIR"
    exit 0
    ;;
  --set-channel)
    if [ -z "${2:-}" ]; then
      fail "Missing channel argument for --set-channel (expected: tagged, stable, main)"
      exit 2
    fi
    set_update_channel "$2"
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage
    fail "Unrecognized argument: $1"
    exit 2
    ;;
esac
