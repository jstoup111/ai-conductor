#!/usr/bin/env bash
set -euo pipefail

# install — Installs the harness skills and conduct script for Claude Code and Codex.
#
# Usage:
#   ./bin/install          # Install everything
#   ./bin/install --check  # Check installation status without changing anything

HARNESS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HARNESS_INSTRUCTIONS_SOURCE="${HARNESS_DIR}/HARNESS.md"
CLAUDE_SKILLS_DIR="${HOME}/.claude/skills"
CODEX_SKILLS_DIR="${HOME}/.agents/skills"
LOCAL_BIN="${HOME}/.local/bin"
HARNESS_USER_CONFIG="${HOME}/.ai-conductor/config.yml"

# The shared accessors own the schema-backed conductor configuration and the
# one-time legacy JSON migration. Keep installer writes on that boundary so
# the installer cannot recreate the former Claude-only state file.
# shellcheck source=bin/lib/harness-common.sh
source "${HARNESS_DIR}/bin/lib/harness-common.sh"

# UPDATE_MODE=true skips first-run-only work (dependency bootstrap, channel
# prompt). Set via the --update flag; used by bin/migrate after an accepted
# harness update.
UPDATE_MODE=false

# ALLOW_WORKTREE_ROOT=true bypasses the worktree-root guard (issue #363). Set
# via the --allow-worktree-root flag, which is stripped from "$@" before the
# mode dispatch so it composes with any mode (e.g. --update).
ALLOW_WORKTREE_ROOT=false

# PROVIDER_SELECTION records the optional, comma-separated built-in provider
# selection supplied to install. Readiness behavior will consume it separately;
# validate it here so an invalid selection never begins a global installation.
PROVIDER_SELECTION=""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
fail() { echo -e "  ${RED}✗${NC} $*"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $*"; }
info() { echo -e "  ${CYAN}→${NC} $*"; }

# Auto-discover every skill: any skills/<name>/ directory containing a SKILL.md.
# Previously this was a hardcoded list that drifted out of sync — new skills
# (engineer, prd-audit, …) were added to skills/ but forgotten here, so they were
# never symlinked into the user-level skill directories. Enumerating the directory
# guarantees ALL skills link for both Claude Code and Codex. Glob results are
# alphabetically sorted by bash (deterministic order).
SKILLS=()
for _skill_dir in "${HARNESS_DIR}"/skills/*/; do
  [ -f "${_skill_dir}SKILL.md" ] || continue
  SKILLS+=("$(basename "$_skill_dir")")
done
unset _skill_dir
if [ ${#SKILLS[@]} -eq 0 ]; then
  fail "No skills found under ${HARNESS_DIR}/skills/ — is the harness checkout intact?"
  exit 1
fi
if [ ! -f "$HARNESS_INSTRUCTIONS_SOURCE" ]; then
  fail "Harness instructions missing: ${HARNESS_INSTRUCTIONS_SOURCE}"
  exit 1
fi

# ─── Worktree-root guard (issue #363) ─────────────────────────────────────────

# Refuse global-mutating installs when this checkout is a build worktree.
# A daemon self-build once ran `bin/install --update` rooted at a worktree:
# every global bin/skill symlink and settings.json hook path was repointed at
# a directory that ship-time worktree removal then deleted, bricking the
# operator environment. The guard keys on the PHYSICAL path (pwd -P) so a
# symlinked logical path cannot hide the `.worktrees` segment. Read-only modes
# (--check, --help) and --uninstall never call this.
guard_worktree_root() {
  if [ "$ALLOW_WORKTREE_ROOT" = true ]; then
    return 0
  fi
  local physical_root
  physical_root="$(cd "$HARNESS_DIR" && pwd -P)"
  case "$physical_root" in
    */.worktrees/*)
      fail "Refusing to install from a build worktree."
      echo ""
      echo "  Resolved harness root: ${physical_root}"
      echo ""
      echo "  Installing from a worktree would repoint your global bins, skills, and"
      echo "  settings.json hooks at a directory that is deleted when the build ships."
      echo ""
      echo "  Fix: run bin/install from the main checkout, or pass --allow-worktree-root"
      echo "  if you really mean to install from this worktree."
      exit 1
      ;;
  esac
}

# ─── Check Mode ───────────────────────────────────────────────────────────────

check_installation() {
  echo -e "${BOLD}Harness Installation Status${NC}"
  echo ""

  local all_ok=true
  local build_auth_ok=true

  # Check every selected built-in CLI. Unlike normal installation, --check is
  # strict: every unavailable selected provider makes the readiness result
  # fail, while an unselected provider does not affect it.
  local selected="${PROVIDER_SELECTION:-claude}"
  local provider
  local -a providers
  IFS=',' read -r -a providers <<< "$selected"
  for provider in "${providers[@]}"; do
    case "$provider" in
      claude)
        if command -v claude &>/dev/null; then
          ok "Claude Code installed ($(claude --version 2>/dev/null || echo 'unknown version'))"
        else
          fail "Claude Code CLI not found on PATH — install it from https://docs.anthropic.com/en/docs/claude-code"
          all_ok=false
        fi
        ;;
      codex)
        if command -v codex &>/dev/null; then
          ok "Codex CLI installed ($(codex --version 2>/dev/null || echo 'unknown version'))"
        else
          fail "Codex CLI not found on PATH — install it with: npm install -g @openai/codex"
          all_ok=false
        fi
        ;;
    esac
  done

  # Check user-level skill directories. Do not use project-local skill paths as
  # the install target: both clients discover these skills from their own user
  # configuration directories.
  local missing=0
  local stale=0
  local duplicates=0
  local skills_dir client skill target harness_target location
  for client in Claude Codex; do
    if [ "$client" = Claude ]; then
      skills_dir="$CLAUDE_SKILLS_DIR"
      location="Claude"
    else
      skills_dir="$CODEX_SKILLS_DIR"
      location="Codex active"
    fi
    if [ -d "$skills_dir" ]; then
      ok "${client} skills directory exists (${skills_dir})"
    else
      fail "${client} skills directory missing (${skills_dir})"
      all_ok=false
    fi

    for skill in "${SKILLS[@]}"; do
      target="${skills_dir}/${skill}"
      if [ -L "$target" ]; then
        local resolved_target
        resolved_target=$(readlink -f "$target" 2>/dev/null || echo "broken")
        if [ "$resolved_target" = "broken" ] || [ ! -e "$resolved_target" ]; then
          fail "${location} skill: ${skill} (${target}) — broken symlink"
          stale=$((stale + 1))
        elif [ "$resolved_target" = "${HARNESS_DIR}/skills/${skill}" ]; then
          ok "${location} skill: ${skill}"
        else
          warn "${location} skill: ${skill} (${target}) — stale target ${resolved_target} (expected ${HARNESS_DIR}/skills/${skill})"
          stale=$((stale + 1))
        fi
      elif [ -e "$target" ]; then
        warn "${location} skill: ${skill} (${target}) — non-symlink entry"
        stale=$((stale + 1))
      else
        fail "${location} skill: ${skill} (${target}) — missing"
        missing=$((missing + 1))
      fi
    done

    harness_target="${skills_dir}/HARNESS.md"
    if [ -L "$harness_target" ]; then
      local resolved_harness
      resolved_harness=$(readlink -f "$harness_target" 2>/dev/null || echo "broken")
      if [ "$resolved_harness" = "broken" ] || [ ! -e "$resolved_harness" ]; then
        fail "${location} harness instructions (${harness_target}) — broken symlink"
        stale=$((stale + 1))
      elif [ "$resolved_harness" = "$HARNESS_INSTRUCTIONS_SOURCE" ]; then
        ok "${location} harness instructions"
      else
        warn "${location} harness instructions (${harness_target}) — stale target ${resolved_harness} (expected ${HARNESS_INSTRUCTIONS_SOURCE})"
        stale=$((stale + 1))
      fi
    elif [ -e "$harness_target" ]; then
      warn "${location} harness instructions (${harness_target}) — non-symlink entry"
      stale=$((stale + 1))
    else
      fail "${location} harness instructions (${harness_target}) — missing"
      missing=$((missing + 1))
    fi
  done

  # Codex's former discovery location must not shadow an active catalog. Do
  # not modify it in check mode: even a foreign entry is useful diagnostic
  # evidence, and reconciliation owns the mutation policy.
  local legacy_dir="${HOME}/.codex/skills" legacy_target
  for skill in "${SKILLS[@]}"; do
    target="${CODEX_SKILLS_DIR}/${skill}"
    legacy_target="${legacy_dir}/${skill}"
    if { [ -e "$target" ] || [ -L "$target" ]; } && { [ -e "$legacy_target" ] || [ -L "$legacy_target" ]; }; then
      fail "Codex duplicate skill: ${skill} — active ${target} and legacy ${legacy_target} both exist"
      duplicates=$((duplicates + 1))
    fi
  done
  harness_target="${CODEX_SKILLS_DIR}/HARNESS.md"
  legacy_target="${legacy_dir}/HARNESS.md"
  if { [ -e "$harness_target" ] || [ -L "$harness_target" ]; } && { [ -e "$legacy_target" ] || [ -L "$legacy_target" ]; }; then
    fail "Codex duplicate harness instructions — active ${harness_target} and legacy ${legacy_target} both exist"
    duplicates=$((duplicates + 1))
  fi

  # Check conduct script
  echo ""
  if command -v conduct &>/dev/null; then
    ok "conduct script on PATH ($(which conduct))"
  else
    fail "conduct script not on PATH"
    all_ok=false
  fi

  # Check conduct-ts (TypeScript conductor). The bundle is built from
  # src/conductor/ by bin/install; report whether it's built and on PATH.
  if [ -f "${HARNESS_DIR}/src/conductor/dist/index.js" ]; then
    if command -v conduct-ts &>/dev/null; then
      ok "conduct-ts built and on PATH ($(which conduct-ts))"
    else
      warn "conduct-ts bundle built but not on PATH — run ./bin/install"
    fi
  else
    warn "conduct-ts bundle not built — run ./bin/install (needs Node >=20.5)"
  fi

  # Check build-auth state (FR-1/FR-3). Delegates entirely to
  # `conduct-ts build-auth-status` — no token path/mode derivation logic
  # here, bash just formats the ok/fail line from the exit code and mirrors
  # the conduct-ts-absent warning pattern above.
  if command -v conduct-ts &>/dev/null; then
    local build_auth_line build_auth_exit
    build_auth_line=$(conduct-ts build-auth-status 2>&1 | head -1) && build_auth_exit=0 || build_auth_exit=$?
    if [ "$build_auth_exit" -eq 0 ]; then
      ok "${build_auth_line}"
    else
      fail "${build_auth_line}"
      build_auth_ok=false
    fi
  else
    warn "build-auth check skipped — conduct-ts not on PATH"
  fi

  # Check dependencies
  echo ""
  if [ -f "$HARNESS_USER_CONFIG" ] && grep -q "^markdown_viewer:" "$HARNESS_USER_CONFIG" 2>/dev/null; then
    local mv_cmd
    if ! command -v conduct-ts &>/dev/null; then
      warn "markdown viewer configured but could not be read — conduct-ts not on PATH"
    elif ! mv_cmd=$(conduct-ts config read markdown_viewer.command 2>/dev/null); then
      warn "markdown viewer configuration unreadable"
    elif [ -n "$mv_cmd" ] && command -v "$mv_cmd" &>/dev/null; then
      ok "markdown viewer: ${mv_cmd} (artifact review)"
    else
      warn "markdown viewer '${mv_cmd:-unset}' configured but not on PATH — will fall back to cat"
    fi
  else
    warn "markdown viewer not configured — run ./bin/install to select one"
  fi
  if [ -f "$HARNESS_USER_CONFIG" ] && grep -q "^mermaid_renderer:" "$HARNESS_USER_CONFIG" 2>/dev/null; then
    local mr_preset mr_cmd
    if ! command -v conduct-ts &>/dev/null; then
      warn "mermaid renderer configured but could not be read — conduct-ts not on PATH"
    elif ! mr_preset=$(conduct-ts config read mermaid_renderer.preset 2>/dev/null) || \
      ! mr_cmd=$(conduct-ts config read mermaid_renderer.command 2>/dev/null); then
      warn "mermaid renderer configuration unreadable"
    elif [ -z "$mr_cmd" ] || command -v "$mr_cmd" &>/dev/null; then
      ok "mermaid renderer: ${mr_preset:-unset} (diagram approval gates)"
    else
      warn "mermaid renderer '${mr_preset}' configured but '${mr_cmd}' not on PATH — diagrams fall back to raw Markdown"
    fi
  else
    warn "mermaid renderer not configured — run ./bin/install to select one"
  fi
  if command -v node &>/dev/null && npm list -g @modelcontextprotocol/server-puppeteer &>/dev/null; then
    ok "puppeteer MCP server installed"
  else
    warn "puppeteer MCP server not installed"
  fi
  # Summary. Return non-zero on ANY drift so `--check` is scriptable — callers
  # (e.g. the conduct-ts install-freshness guard) gate on the exit code.
  echo ""
  if [ "$missing" -eq 0 ] && [ "$stale" -eq 0 ] && [ "$duplicates" -eq 0 ] && $all_ok; then
    if [ "$build_auth_ok" = false ]; then
      echo -e "${RED}${BOLD}Build authentication check failed.${NC}"
      return 2
    fi
    echo -e "${GREEN}${BOLD}All checks passed.${NC}"
    return 0
  else
    [ "$missing" -gt 0 ] && echo -e "${RED}${missing} skill(s) missing.${NC}"
    [ "$stale" -gt 0 ] && echo -e "${YELLOW}${stale} skill(s) stale or misconfigured.${NC}"
    [ "$duplicates" -gt 0 ] && echo -e "${RED}${duplicates} Codex duplicate discovery entry(s).${NC}"
    echo -e "Run ${BOLD}./bin/install${NC} to fix."
    return 1
  fi
}

# ─── Permissions ──────────────────────────────────────────────────────────────

# Permissions the harness needs pre-approved to run without friction
HARNESS_PERMISSIONS=(
  # Read harness files (skills, agents, tech-context)
  "Read(${HARNESS_DIR}/**)"
  # Test runners
  "Bash(bundle exec rspec:*)"
  "Bash(bundle exec standardrb:*)"
  "Bash(bundle exec rails:*)"
  "Bash(bundle install:*)"
  # Project scaffolding
  "Bash(rails new:*)"
  "Bash(rails generate:*)"
  "Bash(docker compose:*)"
  # Git (non-destructive)
  "Bash(git init:*)"
  "Bash(git add:*)"
  "Bash(git commit:*)"
  "Bash(git status:*)"
  "Bash(git log:*)"
  "Bash(git diff:*)"
  "Bash(git branch:*)"
  "Bash(git checkout -b:*)"
  # GitHub (read-only)
  "Bash(gh pr list:*)"
  "Bash(gh issue list:*)"
)

configure_permissions() {
  local settings_file=$1

  if ! command -v python3 &>/dev/null; then
    warn "python3 not found — skipping permissions configuration (re-run bin/install after installing python3)"
    return 1
  fi

  # Write permissions list to a temp file for python to read
  local perms_file
  perms_file=$(mktemp)
  printf '%s\n' "${HARNESS_PERMISSIONS[@]}" > "$perms_file"

  local output
  output=$(python3 << PYEOF
import json, os

settings_path = "$settings_file"
perms_path = "$perms_file"

# Read desired permissions
with open(perms_path) as f:
    harness_perms = [line.strip() for line in f if line.strip()]

# Read or create settings
if os.path.exists(settings_path):
    with open(settings_path) as f:
        settings = json.load(f)
else:
    settings = {}

if "permissions" not in settings:
    settings["permissions"] = {}
if "allow" not in settings["permissions"]:
    settings["permissions"]["allow"] = []

existing = set(settings["permissions"]["allow"])
added = 0
for perm in harness_perms:
    if perm not in existing:
        settings["permissions"]["allow"].append(perm)
        added += 1

with open(settings_path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")

print(f"{added} added, {len(harness_perms) - added} already set")
PYEOF
  )
  local permission_write_status=$?
  rm -f "$perms_file"

  if [ "$permission_write_status" -eq 0 ]; then
    ok "Permissions: ${output}"
  else
    warn "Could not configure permissions automatically"
    info "Manually add harness read permissions to ${settings_file}"
    return 1
  fi
}

# ─── Hooks ────────────────────────────────────────────────────────────────────

configure_hooks() {
  local settings_file=$1
  local hooks_dir="${HARNESS_DIR}/hooks/claude"

  if ! command -v python3 &>/dev/null; then
    warn "python3 not found — skipping hooks configuration (re-run bin/install after installing python3)"
    return 1
  fi

  local output
  output=$(python3 << PYEOF
import json, os

settings_path = "$settings_file"
hooks_dir = "$hooks_dir"

# Read existing settings
if os.path.exists(settings_path):
    with open(settings_path) as f:
        settings = json.load(f)
else:
    settings = {}

if "hooks" not in settings:
    settings["hooks"] = {}

# Define harness hooks
harness_hooks = {
    "PreToolUse": [
        {
            "matcher": "Bash",
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/block-destructive-git.sh",
                    "timeout": 10
                }
            ]
        },
        {
            "matcher": "Bash",
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/tdd-commit-gate.sh",
                    "timeout": 10
                }
            ]
        },
        {
            "matcher": "Edit|Write|NotebookEdit",
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/docs-guard.sh",
                    "timeout": 10
                }
            ]
        }
    ],
    "PostToolUse": [
        {
            "matcher": "Edit|Write",
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/lint-after-edit.sh",
                    "timeout": 30
                },
                {
                    "type": "command",
                    "command": f"{hooks_dir}/spec-coverage-check.sh",
                    "timeout": 10
                },
                {
                    "type": "command",
                    "command": f"{hooks_dir}/diagram-coverage-check.sh",
                    "timeout": 10
                }
            ]
        },
        {
            "matcher": "Bash",
            "hooks": [
                {
                    # Fast-feedback derive on commit (ADR engine-owned
                    # task-status, post-landing amendment): engine-invoking,
                    # strictly advisory — warns when a commit evidences no
                    # task. Occupies the PostToolUse/Bash slot the removed
                    # legacy pipeline-sync hook vacated.
                    "type": "command",
                    "command": f"{hooks_dir}/post-commit-derive-feedback.sh",
                    "timeout": 15
                }
            ]
        }
    ],
    "SessionStart": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/session-start-context.sh",
                    "timeout": 15
                }
            ]
        }
    ],
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/stop-memory-reminder.sh",
                    "timeout": 10
                }
            ]
        }
    ],
    "StopFailure": [
        {
            "matcher": "rate_limit",
            "hooks": [
                {
                    "type": "command",
                    "command": f"{hooks_dir}/rate-limit-wait.sh",
                    "timeout": 10
                }
            ]
        }
    ]
}

# Track what we add
added = 0
skipped = 0

for event, hook_entries in harness_hooks.items():
    if event not in settings["hooks"]:
        settings["hooks"][event] = []

    existing_commands = set()
    for entry in settings["hooks"][event]:
        for h in entry.get("hooks", []):
            existing_commands.add(h.get("command", ""))

    for entry in hook_entries:
        entry_commands = {h.get("command", "") for h in entry.get("hooks", [])}
        if entry_commands - existing_commands:
            settings["hooks"][event].append(entry)
            added += len(entry_commands - existing_commands)
        else:
            skipped += len(entry_commands)

with open(settings_path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")

print(f"{added} added, {skipped} already set")
PYEOF
  )

  if [ $? -eq 0 ]; then
    ok "Hooks: ${output}"
  else
    warn "Could not configure hooks automatically"
    info "Manually add hooks to ${settings_file}"
  fi
}

# ─── Dependencies ────────────────────────────────────────────────────────────

install_dependencies() {
  echo ""
  echo -e "${BOLD}Dependencies${NC}"

  # Markdown viewer — handled by configure_md_viewer (below). Earlier versions
  # hard-installed glow here; the viewer is now user-selectable and installed
  # on-demand inside configure_md_viewer.

  # @modelcontextprotocol/server-puppeteer — MCP server for browser automation
  if command -v node &>/dev/null; then
    if npm list -g @modelcontextprotocol/server-puppeteer &>/dev/null; then
      ok "puppeteer MCP server already installed"
    else
      info "Installing @modelcontextprotocol/server-puppeteer globally..."
      npm install -g @modelcontextprotocol/server-puppeteer 2>/dev/null && ok "puppeteer MCP server installed" || warn "puppeteer MCP install failed"
    fi
  else
    warn "Node.js not found — puppeteer MCP server not installed"
  fi
}

# ─── Markdown viewer config ───────────────────────────────────────────────────

# Preset table parallels src/conductor/src/engine/md-viewer-presets.ts.
# Keep in sync if you add/remove presets on either side.
# Columns: key | label | command | args | mode
MD_VIEWER_PRESETS=(
  "glow|glow       (terminal, paged)|glow|-p -w 80 {file}|inline"
  "bat|bat        (terminal, syntax-highlighted)|bat|--style=plain --paging=never {file}|inline"
  "mdcat|mdcat      (terminal)|mdcat|{file}|inline"
  "code|VSCode     (GUI, code --wait)|code|--wait {file}|blocking"
  "typora|Typora     (GUI)|typora|--wait {file}|blocking"
  "marktext|MarkText   (GUI)|marktext|{file}|external"
  "nvim|neovim     (terminal editor)|nvim|{file}|blocking"
  "obsidian|Obsidian   (GUI)|obsidian|{file}|external"
  "cat|cat        (universal fallback)|cat|{file}|inline"
)

# Mermaid renderer preset catalog — parallels MERMAID_RENDERER_PRESETS in
# src/conductor/src/engine/mermaid-renderer-presets.ts. Keep in sync.
# Columns: key | label | command | args | mode  (command empty = no tool needed)
MERMAID_RENDERER_PRESETS=(
  "html|HTML preview (browser, no native deps — works anywhere)||{file}|external"
  "mmdc-png|PNG images (mermaid-cli, needs Chromium)|mmdc|-i {file} -o {out}|external"
  "mmdc-svg|SVG images (mermaid-cli, needs Chromium)|mmdc|-i {file} -o {out}|external"
  "none|disabled (raw Markdown)||{file}|external"
)

# Try to install one of the terminal viewers via common package managers.
# Silent best-effort; returns 0 if installed or already present, 1 otherwise.
install_md_viewer_tool() {
  local tool=$1
  command -v "$tool" &>/dev/null && return 0
  case "$tool" in
    glow)
      if command -v brew &>/dev/null; then
        brew install glow &>/dev/null && return 0
      fi
      if command -v go &>/dev/null; then
        go install github.com/charmbracelet/glow@latest &>/dev/null && return 0
      fi
      local arch
      arch=$(uname -m)
      case "$arch" in
        x86_64)  arch="x86_64" ;;
        aarch64) arch="arm64" ;;
        *)       return 1 ;;
      esac
      local glow_ver="2.1.0"
      local glow_url="https://github.com/charmbracelet/glow/releases/download/v${glow_ver}/glow_${glow_ver}_Linux_${arch}.tar.gz"
      local glow_tmp="/tmp/glow-install-$$"
      mkdir -p "$glow_tmp"
      if curl -sL "$glow_url" -o "${glow_tmp}/glow.tar.gz" 2>/dev/null; then
        tar -xzf "${glow_tmp}/glow.tar.gz" -C "$glow_tmp" --strip-components=1 2>/dev/null
        if [ -f "${glow_tmp}/glow" ]; then
          mkdir -p "${HOME}/.local/bin"
          mv "${glow_tmp}/glow" "${HOME}/.local/bin/glow"
          chmod +x "${HOME}/.local/bin/glow"
          rm -rf "$glow_tmp"
          return 0
        fi
      fi
      rm -rf "$glow_tmp"
      return 1
      ;;
    bat)
      if command -v brew &>/dev/null; then
        brew install bat &>/dev/null && return 0
      fi
      if command -v apt-get &>/dev/null; then
        sudo apt-get install -y bat &>/dev/null && return 0
      fi
      return 1
      ;;
    mdcat)
      if command -v brew &>/dev/null; then
        brew install mdcat &>/dev/null && return 0
      fi
      if command -v cargo &>/dev/null; then
        cargo install mdcat &>/dev/null && return 0
      fi
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

# Persist the chosen viewer through conduct-ts so it owns YAML preservation.
# Install the tool a mermaid preset needs. html/none need no tool. mmdc-* need
# @mermaid-js/mermaid-cli via npm (only if node is present). Silent best-effort;
# returns 0 if present/installed or no tool needed, 1 otherwise.
install_mermaid_tool() {
  local key=$1
  case "$key" in
    html|none)
      return 0
      ;;
    mmdc-png|mmdc-svg)
      command -v mmdc &>/dev/null && return 0
      if command -v npm &>/dev/null; then
        npm install -g @mermaid-js/mermaid-cli &>/dev/null && return 0
      fi
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

write_md_viewer_config() {
  local preset=$1 cmd=$2 args=$3 mode=$4
  conduct-ts config write markdown_viewer "$preset" "$cmd" "$args" "$mode"
}

# Prompt the user for a markdown viewer preset, probe PATH for availability,
# optionally install the chosen terminal tool, and persist the selection.
# Skipped entirely in --update mode (leaves any existing selection alone).
configure_md_viewer() {
  # Skip in non-interactive or update-mode runs. Emit a nudge if nothing is
  # configured yet so users know how to set it later.
  if [ "$UPDATE_MODE" = true ] || [ ! -t 0 ]; then
    if ! grep -q "^markdown_viewer:" "$HARNESS_USER_CONFIG" 2>/dev/null; then
      info "markdown viewer not configured — run bin/install (no flags) or edit $HARNESS_USER_CONFIG"
    fi
    return 0
  fi
  if ! command -v conduct-ts &>/dev/null; then
    warn "conduct-ts is required to save the markdown viewer; install or restore it, then re-run bin/install"
    return 0
  fi

  echo ""
  info "Markdown viewer — how should /conduct display artifacts for review?"
  echo "    [*] = installed and on PATH"
  echo ""
  local i=1
  local -a preset_keys=()
  local default_idx=""
  local entry key label cmd args mode marker
  for entry in "${MD_VIEWER_PRESETS[@]}"; do
    IFS='|' read -r key label cmd args mode <<< "$entry"
    preset_keys+=("$entry")
    if command -v "$cmd" &>/dev/null; then
      marker=" [*]"
      [ -z "$default_idx" ] && default_idx=$i
    else
      marker=""
    fi
    printf "    %d) %s%s\n" "$i" "$label" "$marker"
    i=$((i + 1))
  done
  printf "    %d) Custom    (enter a command)\n" "$i"
  [ -z "$default_idx" ] && default_idx=1

  local choice
  read -r -p "  Choice [${default_idx}]: " choice
  choice=${choice:-$default_idx}

  if [ "$choice" = "$i" ]; then
    # Custom preset — ask for everything.
    local c_cmd c_args c_mode
    read -r -p "    command (e.g. glow, code, obsidian): " c_cmd
    read -r -p "    args (must include {file}) [${c_cmd} {file}]: " c_args
    c_args=${c_args:-"{file}"}
    read -r -p "    mode (inline|blocking|external) [inline]: " c_mode
    c_mode=${c_mode:-inline}
    case "$c_mode" in
      inline|blocking|external) ;;
      *) warn "invalid mode '${c_mode}' — defaulting to inline"; c_mode=inline ;;
    esac
    if [[ "$c_args" != *"{file}"* ]]; then
      warn "args must contain {file} — appending"
      c_args="${c_args} {file}"
    fi
    if ! write_md_viewer_config "custom" "$c_cmd" "$c_args" "$c_mode"; then
      warn "Could not save markdown viewer configuration"
      return 1
    fi
    ok "Markdown viewer: custom (${c_cmd})"
    return 0
  fi

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -ge "$i" ]; then
    warn "invalid choice '${choice}' — defaulting to preset ${default_idx}"
    choice=$default_idx
  fi

  IFS='|' read -r key label cmd args mode <<< "${preset_keys[$((choice - 1))]}"

  if ! command -v "$cmd" &>/dev/null; then
    info "Trying to install ${key}..."
    if install_md_viewer_tool "$key"; then
      ok "${key} installed"
    else
      warn "${key} not installed automatically — the viewer will fall back to cat until you install it"
      info "Install manually, then re-run bin/install"
    fi
  fi

  if ! write_md_viewer_config "$key" "$cmd" "$args" "$mode"; then
    warn "Could not save markdown viewer configuration"
    return 1
  fi
  ok "Markdown viewer: ${key} (${mode})"
}

write_mermaid_renderer_config() {
  local preset=$1 cmd=$2 args=$3 mode=$4
  conduct-ts config write mermaid_renderer "$preset" "$cmd" "$args" "$mode"
}

# Prompt the user for a mermaid renderer preset, probe availability, optionally
# install the chosen tool, and persist the selection. Parallels configure_md_viewer.
# html/none need no tool (always available); mmdc-* need @mermaid-js/mermaid-cli.
# Skipped in --update / non-interactive runs (leaves any existing selection alone).
configure_mermaid_renderer() {
  if [ "$UPDATE_MODE" = true ] || [ ! -t 0 ]; then
    if ! grep -q "^mermaid_renderer:" "$HARNESS_USER_CONFIG" 2>/dev/null; then
      info "mermaid renderer not configured — run bin/install (no flags) or edit $HARNESS_USER_CONFIG"
    fi
    return 0
  fi
  if ! command -v conduct-ts &>/dev/null; then
    warn "conduct-ts is required to save the mermaid renderer; install or restore it, then re-run bin/install"
    return 0
  fi

  echo ""
  info "Mermaid renderer — how should /conduct show diagrams at the architecture approval gates?"
  echo "    [*] = available now (no tool needed, or tool on PATH)"
  echo ""
  local i=1
  local -a preset_keys=()
  local default_idx=""
  local entry key label cmd args mode marker
  for entry in "${MERMAID_RENDERER_PRESETS[@]}"; do
    IFS='|' read -r key label cmd args mode <<< "$entry"
    preset_keys+=("$entry")
    # A preset is available when it needs no tool (empty command) or its tool is on PATH.
    if [ -z "$cmd" ] || command -v "$cmd" &>/dev/null; then
      marker=" [*]"
      [ -z "$default_idx" ] && default_idx=$i
    else
      marker=""
    fi
    printf "    %d) %s%s\n" "$i" "$label" "$marker"
    i=$((i + 1))
  done
  [ -z "$default_idx" ] && default_idx=1

  local choice
  read -r -p "  Choice [${default_idx}]: " choice
  choice=${choice:-$default_idx}

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -ge "$i" ]; then
    warn "invalid choice '${choice}' — defaulting to preset ${default_idx}"
    choice=$default_idx
  fi

  IFS='|' read -r key label cmd args mode <<< "${preset_keys[$((choice - 1))]}"

  if [ -n "$cmd" ] && ! command -v "$cmd" &>/dev/null; then
    info "Trying to install ${key} (${cmd})..."
    if install_mermaid_tool "$key"; then
      ok "${key} installed"
    else
      warn "${key} not installed automatically — diagrams will fall back to raw Markdown until you install it"
      info "Install manually (npm install -g @mermaid-js/mermaid-cli), then re-run bin/install"
    fi
  fi

  if ! write_mermaid_renderer_config "$key" "$cmd" "$args" "$mode"; then
    warn "Could not save mermaid renderer configuration"
    return 1
  fi
  ok "Mermaid renderer: ${key} (${mode})"
}

# ─── AI Conductor config (channel, current version) ──────────────────────────

# Detect the current harness version from git tag or VERSION file.
# Returns "vX.Y.Z" when on an exact tag, "vX.Y.Z" from VERSION as a fallback,
# or "main@<short-sha>" when on main.
detect_current_version() {
  local tag
  tag=$(git -C "$HARNESS_DIR" describe --tags --exact-match HEAD 2>/dev/null || echo "")
  if [ -n "$tag" ]; then
    echo "$tag"
    return 0
  fi
  if [ -f "${HARNESS_DIR}/VERSION" ]; then
    local v
    v=$(tr -d '[:space:]' < "${HARNESS_DIR}/VERSION")
    if [ -n "$v" ]; then
      echo "v$v"
      return 0
    fi
  fi
  local sha
  sha=$(git -C "$HARNESS_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  echo "main@$sha"
}

# Create or refresh the schema-owned conductor block in ~/.ai-conductor/config.yml.
# First run: prompt for channel (tagged vs main). Update mode: refresh the
# current version and check timestamp while preserving user preferences.
configure_conductor() {
  local detected
  detected=$(detect_current_version)
  local now
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  # Seed before deciding whether this is a first run. A legacy-only install
  # becomes a populated conductor block, whose user preferences must win over
  # first-run defaults.
  if ! seed_conductor_config_from_legacy; then
    warn "Could not seed legacy conductor configuration"
    return 1
  fi

  if [ ! -f "$HARNESS_USER_CONFIG" ]; then
    # First run — pick a channel.
    local channel="tagged"
    if [ "$UPDATE_MODE" != true ] && [ -t 0 ]; then
      echo ""
      info "Harness update channel — which version should /conduct follow?"
      echo "    1) tagged  — stable semver releases (recommended)"
      echo "    2) main    — bleeding edge, every merge to main"
      read -r -p "  Choice [1]: " choice
      case "$choice" in
        2) channel="main" ;;
        *) channel="tagged" ;;
      esac
    fi
    if conductor_cfg_set updateChannel "$channel" && \
      conductor_cfg_set autoCheck true && \
      conductor_cfg_set currentVersion "$detected" && \
      conductor_cfg_set lastCheckedAt "$now"; then
      ok "Created conductor configuration (channel: ${channel}, version: ${detected})"
    else
      warn "Could not create conductor configuration (update checks off until bin/install re-runs)"
      return 1
    fi
  else
    # Update — refresh currentVersion + lastCheckedAt, preserve everything else.
    if conductor_cfg_set currentVersion "$detected" && \
      conductor_cfg_set lastCheckedAt "$now"; then
      ok "Refreshed conductor configuration (version: ${detected})"
    else
      warn "Could not refresh conductor configuration"
      return 1
    fi
  fi
}

# ─── conduct-ts build ─────────────────────────────────────────────────────────

# Return 0 if the active Node satisfies conduct-ts's >=20.5 requirement (execa
# imports addAbortListener, added in Node 20.5). The repo pins 20.19.2 via
# .tool-versions. Returns 1 if Node is absent or too old.
node_supports_conduct_ts() {
  local node_v="" major=0 minor=0 rest=""
  node_v=$(node --version 2>/dev/null | sed 's/^v//') || true
  [ -z "$node_v" ] && return 1
  major=${node_v%%.*}
  rest=${node_v#*.}
  minor=${rest%%.*}
  [ "$major" -gt 20 ] || { [ "$major" -eq 20 ] && [ "$minor" -ge 5 ]; }
}

# Build the conduct-ts bundle: npm ci + npm run build in src/conductor/.
# Runs on both fresh installs and updates so the bundle reflects the checked-out
# harness version and a corrupt node_modules directory is replaced. Non-fatal:
# on any failure it warns and returns 1 so the caller can continue (step 3b then
# reports the missing bundle).
build_conduct_ts() {
  local conductor_dir="${HARNESS_DIR}/src/conductor"
  echo ""
  echo -e "${BOLD}conduct-ts${NC}"

  if [ ! -f "${conductor_dir}/package.json" ]; then
    warn "src/conductor/package.json missing — skipping conduct-ts build"
    return 0
  fi

  if ! command -v npm &>/dev/null; then
    warn "npm not found — cannot build conduct-ts; skipping"
    info "Install Node >=20.5 + npm, then re-run bin/install"
    return 1
  fi

  if ! node_supports_conduct_ts; then
    warn "Node >=20.5 not active (repo pins 20.19.2 via .tool-versions) — skipping conduct-ts build"
    info "Install it (e.g. 'asdf install nodejs 20.19.2'), then re-run bin/install"
    return 1
  fi

  local log
  log=$(mktemp)

  info "Installing conduct-ts dependencies (npm ci)..."
  if (cd "$conductor_dir" && npm ci) >"$log" 2>&1; then
    ok "conduct-ts dependencies installed"
  else
    fail "npm ci failed in src/conductor/ — conduct-ts not built"
    tail -n 20 "$log" | sed 's/^/      /'
    rm -f "$log"
    return 1
  fi

  info "Building conduct-ts bundle (npm run build)..."
  if (cd "$conductor_dir" && npm run build) >"$log" 2>&1; then
    ok "conduct-ts bundle built (src/conductor/dist/index.js)"
  else
    fail "npm run build failed in src/conductor/ — conduct-ts not built"
    tail -n 20 "$log" | sed 's/^/      /'
    rm -f "$log"
    return 1
  fi

  rm -f "$log"
  return 0
}

# ─── Install ──────────────────────────────────────────────────────────────────

choose_builtin_provider() {
  [ -n "$PROVIDER_SELECTION" ] || [ "$UPDATE_MODE" = true ] || [ ! -t 0 ] && return 0

  echo ""
  info "Built-in provider — choose the CLI you plan to use:"
  echo "    1) Claude"
  echo "    2) Codex"
  echo "    3) Both Claude and Codex"
  local choice
  read -r -p "  Choice [1]: " choice || choice=1

  case "$choice" in
    ""|1) PROVIDER_SELECTION="claude" ;;
    2)    PROVIDER_SELECTION="codex" ;;
    3)    PROVIDER_SELECTION="claude,codex" ;;
    *)
      warn "Unrecognized provider choice '${choice}' — using Claude"
      PROVIDER_SELECTION="claude"
      ;;
  esac
}

# Report whether the built-in CLI choices selected for this installation are
# ready to use. This is deliberately advisory: installing the harness must
# still establish both provider surfaces when an external CLI is absent.
report_selected_provider_readiness() {
  local selected="${PROVIDER_SELECTION:-claude}"
  local provider
  local -a providers
  IFS=',' read -r -a providers <<< "$selected"

  echo ""
  info "Built-in provider readiness:"
  for provider in "${providers[@]}"; do
    case "$provider" in
      claude)
        if command -v claude &>/dev/null; then
          ok "Claude Code CLI found"
        else
          warn "Claude Code CLI not found — install it from https://docs.anthropic.com/en/docs/claude-code"
        fi
        ;;
      codex)
        if command -v codex &>/dev/null; then
          ok "Codex CLI found"
        else
          warn "Codex CLI not found — install it with: npm install -g @openai/codex"
        fi
        ;;
    esac
  done
}

# A prior catalog is trusted only when its HARNESS.md resolves to a complete
# harness root. This lets an update refresh links installed by an earlier
# checkout without treating an arbitrary operator-owned symlink as ours.
prior_harness_root() {
  local harness_link=$1 resolved root
  [ -L "$harness_link" ] || return 1
  resolved=$(readlink -f "$harness_link" 2>/dev/null || echo "")
  root=${resolved%/HARNESS.md}
  [ "$resolved" = "${root}/HARNESS.md" ] &&
    [ -f "${root}/HARNESS.md" ] && [ -f "${root}/VERSION" ] &&
    [ -d "${root}/skills" ] || return 1
  printf '%s\n' "$root"
}

# A catalog entry is mutable only when it is an exact link from this checkout,
# or from the complete prior harness identified by this catalog's HARNESS.md.
# Regular files, directories, broken links, and arbitrary links are operator
# content and must stay byte-for-byte/target-for-target intact.
owned_skill_link() {
  local skills_dir=$1 skill=$2 target=$3 current prior_root
  current=$(readlink -f "$target" 2>/dev/null || echo "")
  [ "$current" = "${HARNESS_DIR}/skills/${skill}" ] && return 0
  prior_root=$(prior_harness_root "${skills_dir}/HARNESS.md" 2>/dev/null || echo "")
  [ -n "$prior_root" ] && [ "$current" = "${prior_root}/skills/${skill}" ]
}

owned_harness_link() {
  local target=$1 current
  current=$(readlink -f "$target" 2>/dev/null || echo "")
  [ "$current" = "$HARNESS_INSTRUCTIONS_SOURCE" ] && return 0
  prior_harness_root "$target" >/dev/null 2>&1
}

# Remove catalog links for skills no longer shipped, but only when the
# catalog's HARNESS.md proves a complete prior harness root and the link points
# to that root's same-named skill. Foreign links and non-links are untouched.
reconcile_obsolete_skill_links() {
  local client=$1 skills_dir=$2
  local prior_root candidate candidate_name skill supported current

  prior_root=$(prior_harness_root "${skills_dir}/HARNESS.md" 2>/dev/null || echo "")
  [ -n "$prior_root" ] || return 0

  while IFS= read -r -d '' candidate; do
    candidate_name="${candidate##*/}"
    [ "$candidate_name" = "HARNESS.md" ] && continue
    supported=false
    for skill in "${SKILLS[@]}"; do
      [ "$candidate_name" = "$skill" ] && supported=true && break
    done
    [ "$supported" = true ] && continue

    current=$(readlink -f "$candidate" 2>/dev/null || echo "")
    if [ "$current" = "${prior_root}/skills/${candidate_name}" ]; then
      rm -- "$candidate" ||
        warn "${client} skill: ${candidate_name} — obsolete symlink removal failed"
    fi
  done < <(find "$skills_dir" -mindepth 1 -maxdepth 1 -type l -print0)
}

# Once the active Codex catalog is established in ~/.agents/skills, remove only
# exact harness-owned links left at Codex's former discovery location. A prior
# complete harness catalog is ownership proof here too: a legacy installation
# can legitimately point at an older checkout.
reconcile_legacy_codex_links() {
  local legacy_dir="${HOME}/.codex/skills"
  local skill target

  for skill in "${SKILLS[@]}"; do
    target="${legacy_dir}/${skill}"
    if [ -L "$target" ]; then
      if owned_skill_link "$legacy_dir" "$skill" "$target"; then
        rm -- "$target"
      else
        warn "Codex legacy skill: ${skill} — foreign symlink preserved"
      fi
    elif [ -e "$target" ]; then
      warn "Codex legacy skill: ${skill} — foreign entry preserved"
    fi
  done

  target="${legacy_dir}/HARNESS.md"
  if [ -L "$target" ]; then
    if owned_harness_link "$target"; then
      rm -- "$target"
    else
      warn "Codex legacy harness instructions — foreign symlink preserved"
    fi
  elif [ -e "$target" ]; then
    warn "Codex legacy harness instructions — foreign entry preserved"
  fi
}

install() {
  guard_worktree_root

  echo -e "${BOLD}${CYAN}Installing James Stoup Agents Harness${NC}"
  echo -e "  Source: ${HARNESS_DIR}"
  echo ""

  choose_builtin_provider

  # 1. Ensure directories exist
  mkdir -p "$CLAUDE_SKILLS_DIR" || warn "Could not create $CLAUDE_SKILLS_DIR"
  mkdir -p "$CODEX_SKILLS_DIR" || warn "Could not create $CODEX_SKILLS_DIR"
  mkdir -p "$LOCAL_BIN" || warn "Could not create $LOCAL_BIN"
  ok "Created directories"

  # 2. Symlink skills into each client's user-level discovery directory.
  # Project-local skills remain available only as explicit project overrides.
  local installed=0
  local updated=0
  local skills_dir client skill source target current harness_target
  for client in Claude Codex; do
    if [ "$client" = Claude ]; then
      skills_dir="$CLAUDE_SKILLS_DIR"
    else
      skills_dir="$CODEX_SKILLS_DIR"
    fi

    reconcile_obsolete_skill_links "$client" "$skills_dir"

    for skill in "${SKILLS[@]}"; do
      source="${HARNESS_DIR}/skills/${skill}"
      target="${skills_dir}/${skill}"

      if [ ! -d "$source" ]; then
        warn "Skill source missing: ${source} — skipping"
        continue
      fi

      if [ -L "$target" ]; then
        if owned_skill_link "$skills_dir" "$skill" "$target"; then
          current=$(readlink -f "$target" 2>/dev/null || echo "")
          if [ "$current" = "$source" ]; then
            continue  # Already correct
          fi
          ln -sfn "$source" "$target" || { warn "${client} skill: ${skill} — symlink update failed"; continue; }
          updated=$((updated + 1))
        else
          warn "${client} skill: ${skill} — foreign symlink preserved"
          continue  # Already correct
        fi
      else
        if [ -e "$target" ]; then
          warn "${client} skill: ${skill} — foreign entry preserved"
          continue
        fi
        ln -sfn "$source" "$target" || { warn "${client} skill: ${skill} — symlink failed"; continue; }
        installed=$((installed + 1))
      fi
    done

    harness_target="${skills_dir}/HARNESS.md"
    if [ -L "$harness_target" ]; then
      if owned_harness_link "$harness_target"; then
        current=$(readlink -f "$harness_target" 2>/dev/null || echo "")
        if [ "$current" != "$HARNESS_INSTRUCTIONS_SOURCE" ]; then
          ln -sfn "$HARNESS_INSTRUCTIONS_SOURCE" "$harness_target" || warn "${client} harness instructions — symlink update failed"
        fi
      else
        warn "${client} harness instructions — foreign symlink preserved"
      fi
    else
      if [ -e "$harness_target" ]; then
        warn "${client} harness instructions — foreign entry preserved"
        continue
      fi
      ln -sfn "$HARNESS_INSTRUCTIONS_SOURCE" "$harness_target" || warn "${client} harness instructions — symlink failed"
    fi
  done

  reconcile_legacy_codex_links

  if [ "$installed" -gt 0 ] || [ "$updated" -gt 0 ]; then
    ok "Skills: ${installed} installed, ${updated} updated (${#SKILLS[@]} per client)"
  else
    ok "Skills: all ${#SKILLS[@]} already current for Claude Code and Codex"
  fi

  report_selected_provider_readiness

  # 3. Symlink conduct script
  local conduct_source="${HARNESS_DIR}/bin/conduct"
  local conduct_target="${LOCAL_BIN}/conduct"

  if [ -L "$conduct_target" ]; then
    local current
    current=$(readlink -f "$conduct_target" 2>/dev/null || echo "")
    if [ "$current" != "$conduct_source" ]; then
      ln -sfn "$conduct_source" "$conduct_target" || warn "conduct symlink update failed"
      ok "Updated conduct script symlink"
    else
      ok "conduct script already current"
    fi
  else
    ln -sfn "$conduct_source" "$conduct_target" || warn "conduct symlink failed"
    ok "Installed conduct script to ${conduct_target}"
  fi

  # 3a. Build conduct-ts (npm ci + npm run build) so the dist bundle reflects
  # this harness version before we symlink it. This runs for installs and updates.
  # Non-fatal: a build failure (no npm, wrong Node) just leaves the bundle
  # missing, and step 3b reports that.
  build_conduct_ts || true

  # 3b. Symlink conduct-ts (TypeScript conductor) if the dist bundle exists.
  # conduct-ts is the engine-layer rewrite of conduct; users opt in today by
  # invoking `conduct-ts` explicitly. The bundle is produced by
  # `npm run build` inside src/conductor/ (step 3a above); skip the symlink if
  # it's still missing (build skipped or failed).
  local conduct_ts_source="${HARNESS_DIR}/bin/conduct-ts"
  local conduct_ts_target="${LOCAL_BIN}/conduct-ts"
  local conduct_ts_dist="${HARNESS_DIR}/src/conductor/dist/index.js"

  if [ -f "$conduct_ts_dist" ]; then
    if [ -L "$conduct_ts_target" ]; then
      local current_ts
      current_ts=$(readlink -f "$conduct_ts_target" 2>/dev/null || echo "")
      if [ "$current_ts" != "$conduct_ts_source" ]; then
        ln -sfn "$conduct_ts_source" "$conduct_ts_target" || warn "conduct-ts symlink update failed"
        ok "Updated conduct-ts script symlink"
      else
        ok "conduct-ts script already current"
      fi
    else
      ln -sfn "$conduct_ts_source" "$conduct_ts_target" || warn "conduct-ts symlink failed"
      ok "Installed conduct-ts script to ${conduct_ts_target}"
    fi
  else
    # Build (step 3a) was skipped or failed, so the bundle is absent. Surface the
    # real cause — conduct-ts needs Node >=20.5 (execa imports addAbortListener),
    # and the repo pins 20.19.2 via .tool-versions.
    if node_supports_conduct_ts; then
      info "conduct-ts bundle not found — 'npm run build' in src/conductor/ failed or was skipped; see the conduct-ts section above"
    else
      warn "conduct-ts bundle not found and Node >=20.5 is not active (the repo pins 20.19.2 via .tool-versions). Install it (e.g. 'asdf install nodejs 20.19.2'), then re-run bin/install."
    fi
  fi

  # 4. Configure Claude Code permissions and hooks.
  # Every phase from here on is called through `|| warn` — bash suppresses
  # `set -e` inside a function whose exit status is tested, so no missing
  # optional dependency (python3, brew, npm, viewer tools, ...) can abort the
  # install. Failures degrade to a warning; only the skills-dir check and the
  # worktree-root guard remain fatal.
  local settings_file="${HOME}/.claude/settings.json"
  configure_permissions "$settings_file" || warn "Permissions configuration incomplete — continuing"
  configure_hooks "$settings_file" || warn "Hooks configuration incomplete — continuing"

  # 5. Check PATH (pure bash — no external tools, so it can never abort)
  if [[ ":$PATH:" == *".local/bin"* ]]; then
    ok "~/.local/bin is on PATH"
  else
    warn "~/.local/bin is NOT on PATH"
    info "Add to your shell profile: export PATH=\"\$HOME/.local/bin:\$PATH\""
  fi

  # 6. Install dependencies (skip in --update mode — one-time bootstrap only)
  if [ "$UPDATE_MODE" = true ]; then
    info "Update mode — skipping dependency bootstrap"
  else
    install_dependencies || warn "Optional dependency bootstrap incomplete — continuing"
  fi

  # 6b. Seed or refresh the AI-conductor config (channel prompt only on first run)
  configure_conductor || warn "Conductor config refresh incomplete — continuing"

  # 6c. Prompt for a markdown viewer (skipped on --update)
  configure_md_viewer || warn "Markdown viewer configuration incomplete — continuing"
  configure_mermaid_renderer || warn "Mermaid renderer configuration incomplete — continuing"

  # 7. Check Claude Code
  if command -v claude &>/dev/null; then
    ok "Claude Code found"
  else
    warn "Claude Code not found — install from https://docs.claude.com/en/docs/claude-code"
  fi

  echo ""
  echo -e "${GREEN}${BOLD}Installation complete.${NC}"
  echo ""
  echo -e "  ${BOLD}Quick start:${NC}"
  echo -e "    cd your-project/"
  echo -e "    claude                        # Start Claude Code"
  echo -e "    /conduct                      # Follow the SDLC flow"
  echo ""
  echo -e "  ${BOLD}Or automated:${NC}"
  echo -e "    cd your-project/"
  echo -e "    conduct-ts inline \"your feature description\""
  echo ""
  echo -e "  ${BOLD}Verify:${NC}"
  echo -e "    ./bin/install --check"
}

# ─── Uninstall ────────────────────────────────────────────────────────────────

uninstall() {
  echo -e "${BOLD}${CYAN}Uninstalling James Stoup Agents Harness${NC}"
  echo ""

  local removed=0
  local skills_dir legacy_dir client skill target points_to harness_target
  for client in Claude Codex; do
    if [ "$client" = Claude ]; then
      skills_dir="$CLAUDE_SKILLS_DIR"
    else
      skills_dir="$CODEX_SKILLS_DIR"
    fi
    for skill in "${SKILLS[@]}"; do
      target="${skills_dir}/${skill}"
      if [ -L "$target" ]; then
        points_to=$(readlink -f "$target" 2>/dev/null || echo "")
        if { [ "$client" = Codex ] && owned_skill_link "$skills_dir" "$skill" "$target"; } || \
           { [ "$client" = Claude ] && [[ "$points_to" == "${HARNESS_DIR}"* ]]; }; then
          rm -- "$target"
          removed=$((removed + 1))
        else
          warn "${client} skill: ${skill} — symlink points elsewhere, skipping"
        fi
      elif [ -e "$target" ]; then
        warn "${client} skill: ${skill} — foreign entry preserved"
      fi
    done

    harness_target="${skills_dir}/HARNESS.md"
    if [ -L "$harness_target" ]; then
      points_to=$(readlink -f "$harness_target" 2>/dev/null || echo "")
      if { [ "$client" = Codex ] && owned_harness_link "$harness_target"; } || \
         { [ "$client" = Claude ] && [ "$points_to" = "$HARNESS_INSTRUCTIONS_SOURCE" ]; }; then
        rm -- "$harness_target"
        removed=$((removed + 1))
      else
        warn "${client} harness instructions — symlink points elsewhere, skipping"
      fi
    elif [ -e "$harness_target" ]; then
      warn "${client} harness instructions — foreign entry preserved"
    fi
  done

  legacy_dir="${HOME}/.codex/skills"
  for skill in "${SKILLS[@]}"; do
    target="${legacy_dir}/${skill}"
    if [ -L "$target" ]; then
      if owned_skill_link "$legacy_dir" "$skill" "$target"; then
        rm -- "$target"
        removed=$((removed + 1))
      else
        warn "Codex legacy skill: ${skill} — foreign symlink preserved"
      fi
    elif [ -e "$target" ]; then
      warn "Codex legacy skill: ${skill} — foreign entry preserved"
    fi
  done

  harness_target="${legacy_dir}/HARNESS.md"
  if [ -L "$harness_target" ]; then
    if owned_harness_link "$harness_target"; then
      rm -- "$harness_target"
      removed=$((removed + 1))
    else
      warn "Codex legacy harness instructions — foreign symlink preserved"
    fi
  elif [ -e "$harness_target" ]; then
    warn "Codex legacy harness instructions — foreign entry preserved"
  fi
  ok "Removed ${removed} skill symlinks"

  if [ -L "${LOCAL_BIN}/conduct" ]; then
    rm "${LOCAL_BIN}/conduct"
    ok "Removed conduct script"
  fi

  echo ""
  echo -e "${GREEN}${BOLD}Uninstall complete.${NC}"
}

# ─── Main ─────────────────────────────────────────────────────────────────────

# Strip install-wide options from "$@" before the mode dispatch so they can be
# combined with any mode (e.g. `--update --allow-worktree-root`).
_filtered_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --allow-worktree-root)
      ALLOW_WORKTREE_ROOT=true
      ;;
    --providers)
      shift
      if [ "$#" -eq 0 ] || [ -z "$1" ]; then
        fail "--providers requires a comma-separated selection of Claude and/or Codex"
        exit 1
      fi
      PROVIDER_SELECTION="$1"
      ;;
    --providers=*)
      PROVIDER_SELECTION="${1#--providers=}"
      if [ -z "$PROVIDER_SELECTION" ]; then
        fail "--providers requires a comma-separated selection of Claude and/or Codex"
        exit 1
      fi
      ;;
    *)
      _filtered_args+=("$1")
      ;;
  esac
  shift
done

if [ -n "$PROVIDER_SELECTION" ]; then
  case ",${PROVIDER_SELECTION}," in
    *,,*)
      fail "Provider selection cannot contain an empty value. Supported built-in providers: Claude, Codex"
      exit 1
      ;;
  esac

  IFS=',' read -r -a _selected_providers <<< "$PROVIDER_SELECTION"
  for _provider in "${_selected_providers[@]}"; do
    case "$_provider" in
      claude|codex) ;;
      *)
        fail "Unsupported provider '${_provider}'. Supported built-in providers: Claude, Codex"
        exit 1
        ;;
    esac
  done
  unset _selected_providers _provider
fi

set -- ${_filtered_args[@]+"${_filtered_args[@]}"}
unset _filtered_args

case "${1:-}" in
  --check)     check_installation; exit $? ;;
  --uninstall) uninstall ;;
  --update)    UPDATE_MODE=true; install ;;
  -h|--help)
    echo "Usage: ./bin/install [--check | --update | --uninstall | -h] [--providers claude[,codex]] [--allow-worktree-root]"
    echo ""
    echo "  (no args)     Install/update harness skills and conduct script"
    echo "  --check       Check installation status"
    echo "  --update      Refresh symlinks + settings (skip deps + channel prompt)"
    echo "  --uninstall   Remove all symlinks"
    echo "  --providers   Comma-separated selection of Claude and/or Codex"
    echo "  --allow-worktree-root"
    echo "                Bypass the refusal to install from a .worktrees/ checkout"
    echo "                (installs from a worktree normally repoint global symlinks"
    echo "                at a directory that is deleted at ship time)"
    echo "  -h, --help    Show this help"
    ;;
  *)           install ;;
esac
